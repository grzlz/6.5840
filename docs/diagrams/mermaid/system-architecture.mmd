            SG2_S3[Servidor Shard 3]
            SG2_R2[Raft Instance 2]
        end

        SKC[Shard KV Client<br/>Routing Inteligente]
    end

    subgraph "Lab 4: Servicio Key-Value con Raft (KVRaft)"
        KVC[KV Client<br/>Detección de Duplicados]

        subgraph "Cluster KVRaft"
