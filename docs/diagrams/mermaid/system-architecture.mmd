            SG1_S1[Servidor Shard 1]
            SG1_S2[Servidor Shard 2]
            SG1_S3[Servidor Shard 3]
            SG1_R1[Raft Instance 1]
        end

        subgraph "Grupo de Réplicas 2"
            SG2_S1[Servidor Shard 1]
