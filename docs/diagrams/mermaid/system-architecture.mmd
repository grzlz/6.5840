        SNAP[Snapshot Manager<br/>Compactación de Log]
    end

    subgraph "Lab 3: Algoritmo de Consenso Raft"
        subgraph "Nodo Raft"
            LE[Leader Election<br/>Timeouts + Votos]
            LR[Log Replication<br/>AppendEntries RPC]
            PS[Persistence<br/>State + Log + Vote]
            SM[State Machine<br/>Apply Commands]
        end

        RPC[labrpc<br/>RPC Simulado]
        PERSIST[Persister<br/>Almacenamiento Simulado]
    end

    subgraph "Lab 2: Servidor Key-Value Básico"
